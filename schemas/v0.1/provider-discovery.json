{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/provider-discovery.json",
  "title": "OFSCP Provider Discovery Document (v0.1)",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "provider": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "software": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "contact": {
          "type": "string"
        },
        "authentication": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "login_endpoint": {
              "$ref": "./defs/common.json#/$defs/HttpsUri"
            },
            "registration_endpoint": {
              "$ref": "./defs/common.json#/$defs/HttpsUri"
            }
          },
          "required": [
            "login_endpoint"
          ]
        },
        "publicKeys": {
          "type": "array",
          "minItems": 1,
          "description": "Provider signing keys (Ed25519). Used to verify provider-to-provider requests and signed delivery payloads (§8 Provider Signing Identity). Field names match the user keys endpoint (§4.6).",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "key_id": {
                "type": "string",
                "minLength": 1
              },
              "algorithm": {
                "type": "string",
                "enum": [
                  "Ed25519"
                ]
              },
              "public_key": {
                "type": "string",
                "minLength": 1
              },
              "created_at": {
                "$ref": "./defs/common.json#/$defs/Rfc3339DateTime"
              }
            },
            "required": [
              "key_id",
              "algorithm",
              "public_key"
            ]
          }
        }
      },
      "required": [
        "domain",
        "protocolVersion",
        "software",
        "contact",
        "authentication",
        "publicKeys"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "messageTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "memo",
              "article",
              "message",
              "reaction"
            ]
          }
        },
        "tiers": {
          "type": "array",
          "description": "The access/discoverability tiers this provider supports (see §11 and GET /api/tiers).",
          "items": {
            "$ref": "./defs/common.json#/$defs/Tier"
          }
        },
        "metadataSchemas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "$ref": "./defs/common.json#/$defs/HttpsUri"
              }
            },
            "required": [
              "id",
              "uri"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": true,
          "description": "Advertised provider limits.",
          "properties": {
            "maxUploadBytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Maximum attachment upload size in bytes; uploads over this return 413."
            }
          }
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": true,
      "description": "Deprecated. Core API endpoints are standardized relative to provider domain (see spec). Providers SHOULD NOT include this section; clients MUST ignore it if present."
    }
  },
  "required": [
    "provider",
    "capabilities"
  ]
}