{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/ws/dm-typing.json",
  "title": "OFSCP WS dm.typing event (v0.1)",
  "description": "Emitted to a DM conversation's subscribers when a participant starts or stops typing (§7.4). DM-scoped mirror of channel.typing, keyed by dmId. Soft state with the auto-expiry and disconnect rules of §7.1.",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "dm.typing" },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "required": ["dmId", "user", "state"],
          "properties": {
            "dmId": { "$ref": "../defs/common.json#/$defs/DmId" },
            "user": { "$ref": "../defs/identity.json#/$defs/UserRef" },
            "state": { "type": "string", "enum": ["start", "stop"] }
          }
        }
      }
    }
  ]
}
