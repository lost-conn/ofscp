{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/defs/groups.json",
  "title": "OFSCP v0.1 Group & Channel definitions",
  "type": "object",
  "$defs": {
    "Role": {
      "type": "string",
      "minLength": 1,
      "description": "A membership role. Canonical roles are `owner`, `admin`, and `member`; providers MAY define additional roles.",
      "examples": ["owner", "admin", "member"]
    },
    "JoinPolicy": {
      "type": "string",
      "enum": ["open", "request", "invite"],
      "description": "open = anyone may join; request = join requires approval; invite = invitation only."
    },
    "ChannelType": {
      "type": "string",
      "enum": ["text", "call"]
    },
    "GroupPermissions": {
      "type": "object",
      "description": "Maps an action to the roles permitted to perform it. Common actions: `post`, `moderate`, `manage`. Providers MAY define additional actions.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/Role" }
      },
      "properties": {
        "post": { "type": "array", "items": { "$ref": "#/$defs/Role" } },
        "moderate": { "type": "array", "items": { "$ref": "#/$defs/Role" } },
        "manage": { "type": "array", "items": { "$ref": "#/$defs/Role" } }
      }
    },
    "CallSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["active"],
      "description": "Lightweight call status for a call channel. Full signaling state is defined in §9.",
      "properties": {
        "active": { "type": "boolean" },
        "participants": {
          "type": "array",
          "items": { "$ref": "./identity.json#/$defs/UserRef" }
        }
      }
    },
    "Group": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "owner", "joinPolicy", "tier", "permissions", "createdAt", "updatedAt", "metadata"],
      "description": "Canonical group object. Channels are not embedded; fetch them via GET /api/groups/{groupId}/channels.",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "owner": { "$ref": "./identity.json#/$defs/UserRef" },
        "joinPolicy": { "$ref": "#/$defs/JoinPolicy" },
        "tier": { "$ref": "./common.json#/$defs/Tier" },
        "permissions": { "$ref": "#/$defs/GroupPermissions" },
        "createdAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" },
        "updatedAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" },
        "metadata": { "$ref": "./objects.json#/$defs/MetadataList" }
      }
    },
    "Channel": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "groupId", "type", "tier", "createdAt", "updatedAt", "metadata"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "groupId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/ChannelType" },
        "tier": { "$ref": "./common.json#/$defs/Tier" },
        "topic": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "call": { "$ref": "#/$defs/CallSummary" },
        "createdAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" },
        "updatedAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" },
        "metadata": { "$ref": "./objects.json#/$defs/MetadataList" }
      }
    },
    "Invite": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "groupId", "token", "uses", "createdBy", "createdAt"],
      "description": "A join link / invite token granting membership to a group (optionally a specific channel).",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "groupId": { "type": "string", "minLength": 1 },
        "channelId": {
          "type": "string",
          "minLength": 1,
          "description": "Optional: invite targets a specific channel rather than the whole group."
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "The secret carried by the join link; redeemed at POST /api/invites/{token}/redeem."
        },
        "role": {
          "$ref": "#/$defs/Role",
          "description": "Role granted on redemption (default `member`)."
        },
        "grantsGuest": {
          "type": "boolean",
          "description": "Whether this invite may be redeemed to provision a provider-local guest account (§4.8)."
        },
        "maxUses": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum redemptions; omitted means unlimited."
        },
        "uses": { "type": "integer", "minimum": 0 },
        "expiresAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" },
        "createdBy": { "$ref": "./identity.json#/$defs/UserRef" },
        "createdAt": { "$ref": "./common.json#/$defs/Rfc3339DateTime" }
      }
    }
  }
}
