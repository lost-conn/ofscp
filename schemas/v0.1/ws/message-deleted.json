{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/ws/message-deleted.json",
  "title": "OFSCP WS message.deleted event (v0.1)",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "message.deleted" },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "required": ["groupId", "channelId", "messageId"],
          "properties": {
            "groupId": { "type": "string", "minLength": 1 },
            "channelId": { "type": "string", "minLength": 1 },
            "cursor": {
              "$ref": "../defs/common.json#/$defs/OpaqueCursor",
              "description": "Opaque position of this event in the channel timeline (same cursor space as REST history, §7.2). Clients persist this to resume via subscribe.since."
            },
            "messageId": { "type": "string", "minLength": 1 },
            "deletedAt": { "$ref": "../defs/common.json#/$defs/Rfc3339DateTime" }
          }
        }
      }
    }
  ]
}
