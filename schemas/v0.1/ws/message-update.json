{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/ws/message-update.json",
  "title": "OFSCP WS message.update command (v0.1)",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "message.update" },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "required": ["groupId", "channelId", "messageId", "content"],
          "properties": {
            "groupId": { "type": "string", "minLength": 1 },
            "channelId": { "type": "string", "minLength": 1 },
            "messageId": { "type": "string", "minLength": 1 },
            "content": { "$ref": "../defs/messaging.json#/$defs/Content" }
          }
        }
      }
    }
  ]
}
