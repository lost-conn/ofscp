{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ofscp/schemas/v0.1/group-update-request.json",
  "title": "OFSCP Group Update Request (v0.1)",
  "description": "Partial update (PATCH). All fields optional; omitted fields are unchanged.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "discoverability": { "$ref": "./defs/common.json#/$defs/Discoverability" },
    "joinPolicy": { "$ref": "./defs/groups.json#/$defs/JoinPolicy" },
    "permissions": { "$ref": "./defs/groups.json#/$defs/GroupPermissions" },
    "metadata": { "$ref": "./defs/objects.json#/$defs/MetadataList" }
  }
}
